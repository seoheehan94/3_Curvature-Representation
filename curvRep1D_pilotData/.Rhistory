Nsubj = 12,
trials_per_subj = 405,
mu_sm = mu_sm,
mu_nv = mu_nv,
mu_ang = mu_ang,
sd_sm = sd_sm,
sd_nv = sd_nv,
sd_ang = sd_ang
)
dsim %>%
count(trial_id, pos_index) %>%
filter(n > 1)
dsim %>%
count(trial_id) %>%
count(n)
