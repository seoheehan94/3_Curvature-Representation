library(tibble)
library(readr)
library(dplyr)
library(purrr)
library(tibble)
# 1. Folder containing Experiment 3 participant CSVs
# Assumes this script is inside Open_Answer_Analysis
data_dir <- "../Exp3/Exp3_curvature/data"
csv_files <- list.files(
data_dir,
pattern = "\\.csv$",
full.names = TRUE
)
stopifnot(length(csv_files) > 0)
library(readr)
library(dplyr)
library(purrr)
library(tibble)
# 1. Folder containing Experiment 3 participant CSVs
# Assumes this script is inside Open_Answer_Analysis
data_dir <- "../Exp3/Exp3_curvature/data"
