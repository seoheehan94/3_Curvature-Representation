"Yes, informal or self-taught experience"
) ~ "Any experience",
art_experience %in% c(
"Limited, occasional experience",
"No experience"
) ~ "Little or no experience",
TRUE ~ NA_character_
),
art_group = factor(
art_group,
levels = c("Any experience", "Little or no experience")
)
) %>%
filter(!is.na(art_group))
# Join to cluster membership
cluster_art_2cat <- participant_clusters %>%
left_join(participant_art_2cat, by = "subj_id") %>%
filter(
!is.na(cluster),
!is.na(art_group)
) %>%
mutate(
cluster = factor(cluster)
)
# Contingency table
cluster_art_2cat_table <- table(
cluster_art_2cat$cluster,
cluster_art_2cat$art_group
)
cluster_art_2cat_table
# Fisher's exact test
fisher_art_2cat <- fisher.test(cluster_art_2cat_table)
fisher_art_2cat
# Effect size: phi (equivalent to Cramer's V for 2x2)
if (!requireNamespace("effectsize", quietly = TRUE)) {
install.packages("effectsize")
}
effectsize::phi(cluster_art_2cat_table)
run_ordinal_mds <- function(rdm, ndim) {
weight_matrix <- ifelse(is.na(rdm), 0, 1)
dissimilarity_matrix <- rdm
dissimilarity_matrix[is.na(dissimilarity_matrix)] <- 0
diag(dissimilarity_matrix) <- 0
diag(weight_matrix) <- 0
smacof::mds(
delta = dissimilarity_matrix,
weightmat = weight_matrix,
type = "ordinal",
ndim = ndim
)
}
extract_mds_coords <- function(mds_fit, stim_lookup) {
as.data.frame(mds_fit$conf) %>%
rownames_to_column("stim_id") %>%
mutate(stim_id = as.integer(stim_id)) %>%
rename_with(
~ paste0("D", seq_along(.)),
-stim_id
) %>%
left_join(stim_lookup, by = "stim_id")
}
## Compute stress for multiple dimensionalities
# stress is a lack-of-fit measure between:
# The observed dissimilarities and the distances in the low-dimensional space (e.g., 2D)
# “How much information about the dissimilarity structure is lost when I force it into 2 dimensions?”
# If stress is low, then the 2D configuration preserves the rank order of your empirical dissimilarities well.
# If stress is high, 2D is insufficient → try 3D, 4D, etc.
# Stress < 0.05 → excellent fit
# 0.05–0.10 → good
# 0.10–0.20 → fair
# 0.20 → poor
dims <- 1:8
cluster_stress <- cluster_rdms %>%
select(cluster, n_subj, mean_RDM) %>%
mutate(
stress = map(
mean_RDM,
~ map_dfr(dims, function(ndim) {
fit <- run_ordinal_mds(.x, ndim)
tibble(
ndim = ndim,
stress = fit$stress
)
})
)
) %>%
unnest(stress)
cluster_stress
ggplot(
cluster_stress,
aes(x = ndim, y = stress)
) +
geom_point(size = 3) +
geom_line() +
facet_wrap(~ cluster) +
theme_classic(base_size = 14) +
labs(
x = "Number of dimensions",
y = "Stress",
title = "Ordinal MDS stress by cluster"
)
ndim_by_cluster <- c(
`1` = 3,
`2` = 5
)
cluster_mds <- cluster_rdms %>%
mutate(
ndim = ndim_by_cluster[as.character(cluster)],
mds = map2(
mean_RDM,
ndim,
run_ordinal_mds
),
stress = map_dbl(mds, "stress"),
coordinates = map2(
mds,
mean_RDM,
~ extract_mds_coords(.x, stim_lookup)
)
)
cluster_mds %>%
select(cluster, n_subj, ndim, stress)
cluster_coords <- cluster_mds %>%
select(cluster, n_subj, coordinates) %>%
unnest(coordinates)
cluster_coords_img <- cluster_coords %>%
mutate(
nv_str  = paste0("N", nv),
rng_str  = paste0("rng", rng),
s_str   = paste0("curv", sm),
img_file = paste0("circle_", rng_str, "_", nv_str, "_", s_str, "_seed10.png"),
img_path = file.path("../figures/images", img_file)
)
plot_mds_projection_img <- function(df, d1, d2, title = "") {
ggplot(df, aes(x = .data[[d1]], y = .data[[d2]])) +
geom_image(aes(image = img_path), size = 0.1) +
theme_classic(base_size = 14) +
labs(x = d1, y = d2, title = title)
}
# Get cluster-specific max dimension
cluster_max_dim <- tibble(
cluster = factor(names(ndim_by_cluster)),
max_dim = as.integer(ndim_by_cluster)
)
# Generate all unique pairs of dimensions per cluster
dim_pairs_list <- split(
cluster_max_dim,
seq_len(nrow(cluster_max_dim))
) %>%
map(function(row) {
cl <- row$cluster
nd <- row$max_dim
dims <- paste0("D", seq_len(nd))
pairs <- t(combn(dims, 2))
tibble(
cluster = cl,
d1 = pairs[, 1],
d2 = pairs[, 2]
)
})
dim_pairs <- bind_rows(dim_pairs_list)
# Loop over clusters and dimension pairs
for (cl in unique(dim_pairs$cluster)) {
dfc <- cluster_coords_img %>% filter(cluster == cl)
pairs_cl <- dim_pairs %>% filter(cluster == cl)
for (i in seq_len(nrow(pairs_cl))) {
d1 <- pairs_cl$d1[i]
d2 <- pairs_cl$d2[i]
title <- paste0(
"Cluster ", cl,
" — Ordinal MDS ", ndim_by_cluster[as.character(cl)], "D: ",
d1, " vs ", d2
)
print(
plot_mds_projection_img(dfc, d1, d2, title)
)
}
}
# Vector fitting / projection: Project each feature as a vector through the space that maximally correlates with point positions.
# D1, D2, D3: coordinates of the fitted feature vector
#r2: strength of feature representation (proportion of variance in the feature explained by projection onto the entire MDS configuration)
# pr(>r): The probability that a random permutation of the feature values would produce an r² as large or larger than the observed one
run_vector_fit <- function(data, ndim = 4, permutations = 999) {
coordinate_columns <- paste0("D", seq_len(ndim))
coordinates <- data %>%
select(all_of(coordinate_columns))
features <- data %>%
select(sm, nv, rng) %>%
mutate(across(everything(), as.numeric))
vegan::envfit(
coordinates,
features,
permutations = permutations,
choices = seq_len(ndim),
w = NULL
)
}
cluster_vector_fits <- cluster_coords %>%
group_by(cluster) %>%
nest() %>%
mutate(
ndim = map_int(
cluster,
~ ndim_by_cluster[[as.character(.x)]]
),
envfit = map2(
data,
ndim,
run_vector_fit
)
)
vector_fit_results <- cluster_vector_fits %>%
transmute(
cluster,
results = map(
envfit,
~ tibble(
feature = names(.x$vectors$r),
r_squared = unname(.x$vectors$r),
p_value = unname(.x$vectors$pvals)
)
)
) %>%
unnest(results) %>%
mutate(
feature = factor(
feature,
levels = c("sm", "nv", "rng"),
labels = c("sm", "nv", "rng")
)
)
vector_fit_results
# Cluster 1
ggplot(
filter(vector_fit_results, cluster == 1),
aes(
x = feature,
y = r_squared,
fill = feature
)
) +
geom_col(
width = 0.65,
colour = "black"
) +
geom_text(
aes(
label = if_else(p_value < 0.05, "*", "")
),
vjust = -0.3,
size = 6
) +
scale_fill_manual(
values = feat_cols,
name = "Feature",
guide = "none"
) +
theme_classic(base_size = 14) +
scale_y_continuous(
limits = c(0, 1),
expand = expansion(mult = c(0, 0.05))
) +
labs(
x = NULL,
y = expression(r^2),
title = "Cluster 1"
)
# Cluster 2
ggplot(
filter(vector_fit_results, cluster == 2),
aes(
x = feature,
y = r_squared,
fill = feature
)
) +
geom_col(
width = 0.65,
colour = "black"
) +
geom_text(
aes(
label = if_else(p_value < 0.05, "*", "")
),
vjust = -0.3,
size = 6
) +
scale_fill_manual(
values = feat_cols,
name = "Feature",
guide = "none"
) +
theme_classic(base_size = 14) +
scale_y_continuous(
limits = c(0, 1),
expand = expansion(mult = c(0, 0.05))
) +
labs(
x = NULL,
y = expression(r^2),
title = "Cluster 2"
)
extract_abs_loadings <- function(envfit_obj, cluster_id) {
arrows <- envfit_obj$vectors$arrows %>%
as.data.frame() %>%
rownames_to_column("feature")      # sm, nv, rng
dim_names <- colnames(envfit_obj$vectors$arrows)  # e.g. D1, D2, D3 or D1..D5
arrows %>%
mutate(
cluster = cluster_id,
feature = factor(feature, levels = c("sm", "nv", "rng"))
) %>%
pivot_longer(
cols = all_of(dim_names),
names_to = "dimension",
values_to = "loading"
) %>%
mutate(
loading = abs(loading)          # ignore sign
)
}
# Extract loadings per cluster using the actual ndim per cluster
load_all <- map2_dfr(
cluster_vector_fits$envfit,
cluster_vector_fits$cluster,
~ extract_abs_loadings(.x, cluster_id = .y)
)
# Colours and feature levels (same as before)
feat_levels <- c("sm", "nv", "rng")
feat_cols   <- scales::hue_pal()(3)
names(feat_cols) <- feat_levels
# Cluster 1
ggplot(
filter(load_all, cluster == 1),
aes(x = dimension, y = loading, fill = feature)
) +
geom_col(
position = position_dodge(width = 0.6),
width = 0.6,
colour = "black"
) +
scale_fill_manual(
values = feat_cols,
name = "Feature",
guide = "none"
) +
theme_classic(base_size = 13) +
labs(
x = NULL,
y = "|vector loading|",
title = "Cluster 1"
) +
scale_y_continuous(limits = c(0, 1.02), expand = c(0, 0))
# Cluster 2
ggplot(
filter(load_all, cluster == 2),
aes(x = dimension, y = loading, fill = feature)
) +
geom_col(
position = position_dodge(width = 0.6),
width = 0.6,
colour = "black"
) +
scale_fill_manual(
values = feat_cols,
name = "Feature",
guide = "none"
) +
theme_classic(base_size = 13) +
labs(
x = NULL,
y = "|vector loading|",
title = "Cluster 2"
) +
scale_y_continuous(limits = c(0, 1.02), expand = c(0, 0))
