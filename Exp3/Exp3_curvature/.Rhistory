library(readr)
library(dplyr)
library(purrr)
library(tibble)
# 1. Folder containing Experiment 3 participant CSVs
# Assumes this script is inside Open_Answer_Analysis
# Select any ONE participant CSV from the Exp3_curvature/data folder
data_dir <- dirname(file.choose())
csv_files <- list.files(
data_dir,
pattern = "\\.csv$",
full.names = TRUE
)
stopifnot(length(csv_files) > 0)
# 2. Extract participant ID and open-ended answer
extract_open_answer <- function(file) {
dat <- read_csv(
file,
col_types = cols(.default = col_character()),
show_col_types = FALSE
)
# Extract ID from filename:
# Han_curvRep2D_v2_73405_SESSION_...csv
subj_id <- sub(
".*_([0-9]+)_SESSION_.*",
"\\1",
basename(file)
)
# Identify the open-answer column
answer_cols <- grep(
"open.?answer|open.?response|free.?text|textbox|text.?response",
names(dat),
value = TRUE,
ignore.case = TRUE
)
# Exclude timing columns
answer_cols <- answer_cols[
!grepl(
"started|stopped|duration|\\.rt$",
answer_cols,
ignore.case = TRUE
)
]
if (length(answer_cols) == 0) {
stop(
"Open-answer column not found in: ",
basename(file),
"\nAvailable columns: ",
paste(names(dat), collapse = ", ")
)
}
# Prefer the actual text/response column
preferred <- answer_cols[
grepl(
"\\.text$|\\.response$|^open_answer$",
answer_cols,
ignore.case = TRUE
)
]
answer_col <- if (length(preferred) > 0) {
preferred[1]
} else {
answer_cols[1]
}
responses <- trimws(dat[[answer_col]])
responses <- responses[
!is.na(responses) & responses != ""
]
# Take last recorded non-empty response
open_answer <- if (length(responses) > 0) {
tail(responses, 1)
} else {
NA_character_
}
tibble(
subj_id = subj_id,
open_answer = open_answer
)
}
# 3. Combine all participants
exp3_open_answers <- map_dfr(
csv_files,
extract_open_answer
) %>%
arrange(as.numeric(subj_id))
library(readr)
library(dplyr)
library(purrr)
library(tibble)
# Select one CSV from the Experiment 3 data folder
data_dir <- dirname(file.choose())
# Find all CSVs in that folder
csv_files <- list.files(
data_dir,
pattern = "\\.csv$",
full.names = TRUE,
ignore.case = TRUE
)
cat("CSV files found:", length(csv_files), "\n")
# Extract participant ID and strategy response
extract_open_answer <- function(file) {
dat <- read_csv(
file,
col_types = cols(.default = col_character()),
show_col_types = FALSE
)
# Participant ID from filename
subj_id <- sub(
".*_([0-9]+)_SESSION_.*",
"\\1",
basename(file)
)
# Extract strategy_open
if (!"strategy_open" %in% names(dat)) {
warning("Missing strategy_open in: ", basename(file))
return(tibble(
subj_id = subj_id,
open_answer = NA_character_
))
}
responses <- trimws(dat$strategy_open)
responses <- responses[
!is.na(responses) & responses != ""
]
open_answer <- if (length(responses) > 0) {
tail(responses, 1)
} else {
NA_character_
}
tibble(
subj_id = subj_id,
open_answer = open_answer
)
}
# Combine all participants
exp3_open_answers <- map_dfr(
csv_files,
extract_open_answer
) %>%
arrange(as.numeric(subj_id))
# Inspect
print(exp3_open_answers, n = Inf)
# Save to Exp3_curvature folder
write_csv(
exp3_open_answers,
file.path(
dirname(data_dir),
"exp3_open_answers.csv"
)
)
