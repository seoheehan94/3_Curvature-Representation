))
# EXP2 VERTICES — 15 total mentions
exp2_vertices_word_freq <- make_word_freq(c(
"number of edges" = 3,
"number of curves" = 2,
"number of spikes" = 2,
"amount of points" = 1,
"complexity" = 1,
"frequency of peaks" = 1,
"number of angles" = 1,
"number of bumps" = 1,
"number of grooves" = 1,
"number of loops" = 1,
"number of protrusions" = 1
))
# EXP2 RANGE — 4 total mentions
exp2_range_word_freq <- make_word_freq(c(
