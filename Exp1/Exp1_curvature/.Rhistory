"complexity" = 1,
"height of spikes" = 1,
"intensity of peaks" = 1
))
# Ensure copied frequency lists sum to the expected number of mentions
stopifnot(
sum(word_freq$frequency) == 84,
sum(vertices_word_freq$frequency) == 47,
sum(angle_word_freq$frequency) == 25,
sum(exp2_smoothness_word_freq$frequency) == 94,
sum(exp2_vertices_word_freq$frequency) == 15,
sum(exp2_range_word_freq$frequency) == 4
)
# Inspect each frequency table and revised percentages
print(word_freq, n = Inf)
print(vertices_word_freq, n = Inf)
print(angle_word_freq, n = Inf)
print(exp2_smoothness_word_freq, n = Inf)
print(exp2_vertices_word_freq, n = Inf)
print(exp2_range_word_freq, n = Inf)
# One plotting function keeps formatting consistent across all six clouds.
dir.create(
"open_answer_outputs/figures",
recursive = TRUE,
showWarnings = FALSE
)
plot_wordcloud <- function(dat, low, high, filename, shorten_number_of = FALSE) {
dat <- dat %>%
mutate(label = if (shorten_number_of) sub("^number of ", "", term) else term)
set.seed(123)
p <- ggplot(dat, aes(label = label, size = frequency, color = frequency)) +
ggwordcloud::geom_text_wordcloud_area(rm_outside = TRUE) +
scale_size_area(max_size = 60) +
scale_color_gradient(low = low, high = high) +
theme_void() +
theme(legend.position = "none")
print(p)
ggsave(
filename = file.path("open_answer_outputs", "figures", filename),
plot = p,
width = 10,
height = 6,
dpi = 300
)
invisible(p)
}
# Exp 1 — retains original output names
p_wordcloud <- plot_wordcloud(
word_freq, "#FBC8C4", "#D94B42", "exp1_smoothness_wordcloud.png"
)
p_vertices_wordcloud <- plot_wordcloud(
vertices_word_freq, "#A5E8B7", "#008A29", "exp1_vertices_wordcloud.png",
shorten_number_of = TRUE
)
p_angle_wordcloud <- plot_wordcloud(
angle_word_freq, "#BFD6FF", "#326BC9", "exp1_angle_wordcloud.png"
)
# Exp 2 — new figures
p_exp2_smoothness_wordcloud <- plot_wordcloud(
exp2_smoothness_word_freq, "#FBC8C4", "#D94B42",
"exp2_smoothness_wordcloud.png"
)
p_exp2_vertices_wordcloud <- plot_wordcloud(
exp2_vertices_word_freq, "#A5E8B7", "#008A29",
"exp2_vertices_wordcloud.png", shorten_number_of = TRUE
)
p_exp2_range_wordcloud <- plot_wordcloud(
exp2_range_word_freq, "#BFD6FF", "#326BC9",
"exp2_range_wordcloud.png"
)
